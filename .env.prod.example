# DataWrangler — production environment template.
# Copy to .env.prod and replace every "REPLACE_ME" before deploying.
# The backend refuses to boot when ENVIRONMENT=production and required values
# are unset (see backend/app/config.py::enforce_production_safety).

# --- Core ---
ENVIRONMENT=production
LOG_LEVEL=INFO

# --- Database (compose-internal hostnames) ---
POSTGRES_USER=REPLACE_ME
POSTGRES_PASSWORD=REPLACE_ME
DATABASE_URL=postgresql+asyncpg://REPLACE_ME:REPLACE_ME@postgres:5432/datawrangler
DATABASE_URL_SYNC=postgresql+psycopg2://REPLACE_ME:REPLACE_ME@postgres:5432/datawrangler

# --- Redis / Celery broker ---
REDIS_URL=redis://redis:6379/0

# --- Security ---
# Generate with: openssl rand -hex 32
SECRET_KEY=REPLACE_ME_AT_LEAST_32_BYTES_HEX
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=REPLACE_ME_BASE64_32_BYTES

# --- CORS (must include the public frontend origin) ---
CORS_ORIGINS=["https://datawrangler.ameritas.com"]

# --- OIDC / SSO (Okta or Azure AD in production) ---
OIDC_ISSUER_URL=https://REPLACE_ME.okta.com/oauth2/default
OIDC_CLIENT_ID=REPLACE_ME
OIDC_CLIENT_SECRET=REPLACE_ME
OIDC_REDIRECT_URI=https://datawrangler.ameritas.com/api/v1/auth/sso/callback

# --- JWT ---
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_MINUTES=10080

# --- Service account API keys (comma-separated, for /api/v1/auth/token) ---
SERVICE_ACCOUNT_API_KEYS=

# --- LLM ---
LLM_PROVIDER=claude
CLAUDE_API_KEY=REPLACE_ME
OLLAMA_URL=
OLLAMA_MODEL=

# --- Storage ---
STORAGE_BACKEND=s3
STORAGE_LOCAL_PATH=/data/storage
S3_ENDPOINT_URL=
S3_BUCKET=ameritas-datawrangler
S3_ACCESS_KEY=REPLACE_ME
S3_SECRET_KEY=REPLACE_ME
S3_REGION=us-east-1

# --- Frontend (public URL the browser will reach) ---
FRONTEND_URL=https://datawrangler.ameritas.com
NEXT_PUBLIC_API_URL=https://datawrangler.ameritas.com
NEXT_PUBLIC_OIDC_ISSUER=https://REPLACE_ME.okta.com
