# DataWrangler Environment Configuration
# Copy to .env and update values

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/datawrangler
DATABASE_URL_SYNC=postgresql+psycopg2://postgres:postgres@localhost:5432/datawrangler

# Redis
REDIS_URL=redis://localhost:6379/0

# Security — MUST change in non-development environments
SECRET_KEY=change-me-in-production

# CORS
CORS_ORIGINS=["http://localhost:3000"]

# Logging
LOG_LEVEL=INFO

# Environment (development | staging | production)
ENVIRONMENT=development

# OIDC / SSO (Keycloak dev defaults — override for production Okta/Azure AD)
OIDC_ISSUER_URL=http://localhost:8080/realms/datawrangler
OIDC_CLIENT_ID=datawrangler-app
OIDC_CLIENT_SECRET=dev-secret
OIDC_REDIRECT_URI=http://localhost:8000/api/v1/auth/sso/callback

# JWT
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_MINUTES=10080

# Service Account API Keys (comma-separated)
SERVICE_ACCOUNT_API_KEYS=

# LLM Provider (Phase 6)
LLM_PROVIDER=claude
CLAUDE_API_KEY=
OLLAMA_URL=http://localhost:11434

# Storage (Phase 9)
STORAGE_BACKEND=local
